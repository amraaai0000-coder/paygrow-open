# ---------------------------------------------------------------------------
# Local development only. On Render these come from the dashboard's
# Environment Variables section - never commit real keys.
# Copy this file to .env and fill it in.
# ---------------------------------------------------------------------------

# Spoonacular - https://spoonacular.com/food-api/console
SPOONACULAR_API_KEY=

# true = serve a built-in sample catalog when the key is missing (handy while
# building the UI). false = always call the real API, error out if no key.
ALLOW_MOCK=true

# Identical searches are cached this long, so a repeated demo does not spend
# the 150 points/day free allowance twice.
SPOONACULAR_CACHE_TTL_SECONDS=3600

# Sarvam AI - speech in (Saaras) + speech out (Bulbul)
# https://dashboard.sarvam.ai  -> API key
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
SARVAM_STT_MODE=codemix
# unknown = auto-detect the language from the audio (recommended)
SARVAM_STT_LANGUAGE=unknown
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
# only a last-resort fallback; the language normally comes from the audio/text
SARVAM_TTS_LANGUAGE=hi-IN

# Which LLM thinks: sarvam | groq | auto (sarvam first, then groq)
LLM_PROVIDER=sarvam
# sarvam-m was retired upstream; sarvam-105b is the current model. Both are
# tried, so an account that still has sarvam-m will use it first.
SARVAM_LLM_MODEL=sarvam-105b

# Groq - used as the fallback LLM (intent planning + spoken narration)
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Agent behaviour: narration is split into chunks of this many characters
# before each Sarvam TTS call (bulbul:v3 allows up to 2500 per request).
TTS_CHUNK_CHARS=800
AGENT_CARDS_PER_ITEM=2

# PayPal sandbox - https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE=https://api-m.sandbox.paypal.com

# Money. PayPal India cannot receive domestic INR, so keep USD for the demo.
CURRENCY=USD

# Where PayPal sends the user after approve / cancel
# Absolute http(s) URLs only - PayPal rejects custom schemes like speakcart://
RETURN_URL=https://example.com/paypal/return
CANCEL_URL=https://example.com/paypal/cancel
BRAND_NAME=SpeakCart

# --- Email login (one-time codes) ------------------------------------------
# Brevo sends the login code. Get the key from brevo.com -> SMTP & API -> API Keys.
BREVO_API_KEY=
# Must be a verified sender in Brevo (your signup email is verified already)
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=PayGrow

# Fallback if you would rather use plain SMTP than Brevo
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
